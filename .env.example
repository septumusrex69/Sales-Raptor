# Copy this file to .env.local and fill in your own Supabase project values.
# Find both under Supabase Dashboard → Settings → API.
# Never commit .env.local — it's already covered by the *.local rule in .gitignore.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Used only by api/invite-user.ts (a server-side function, never shipped to
# the browser). This is the SECRET service_role key, not the anon key above —
# find it under Supabase Dashboard → Settings → API → "Secret keys". Do not
# prefix this one with VITE_, or Vite would bundle it into client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# The rest are server-side only (never VITE_). Set each in Vercel for Production AND Preview.

# AES-256-GCM key for the mailbox passwords stored in Raptor. Lose it and every connected mailbox
# must be reconnected. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMAIL_CREDENTIALS_KEY=your-64-char-hex-key

# Shared secret on the Connect Mobile and BuzzBox callback URLs (?key=<value>).
SMS_WEBHOOK_KEY=your-random-secret

# Connect Mobile's API token, for sending SMS.
CONNECT_MOBILE_API_TOKEN=your-connect-mobile-token

# Vercel Cron sends it as "Authorization: Bearer <value>". Without it the morning workflow run and the
# five-minute company mail sync refuse to run unattended (a signed-in person can still start them).
CRON_SECRET=your-random-secret
