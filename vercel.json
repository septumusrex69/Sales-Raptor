{
  "regions": [
    "cdg1"
  ],
  "git": {
    "deploymentEnabled": {
      "claude/**": false,
      "claude/sales-raptor-review-p1pzx2": true
    }
  },
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "public/fonts/charter/*.ttf",
      "maxDuration": 300
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; connect-src 'self' https://*.supabase.co wss://*.supabase.co; font-src 'self' data:; frame-src 'self' blob: data:; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/((?!api/|assets/|brand/|favicon\\.svg).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/email/sync-all",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/portal/photo-check",
      "schedule": "37 4 * * *"
    },
    {
      "path": "/api/workflow/run",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/workflow/balances",
      "schedule": "5 22 * * *"
    },
    {
      "path": "/api/email/marketing-daily",
      "schedule": "13 5 * * *"
    }
  ]
}
